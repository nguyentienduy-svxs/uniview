# ============================================================
# UniView Frontend — Environment Configuration
# ============================================================

# API endpoints
VITE_API_URL=http://localhost:8080/api/v1
VITE_ASSESSMENT_API_URL=http://localhost:8080/api/v1

# Auth mode: 'mock' | 'api'
# mock  = dùng local storage + demo accounts (không cần backend)
# api   = kết nối Spring Boot backend thật
VITE_AUTH_MODE=mock

# Data mode: 'mock' | 'real'
# mock  = dùng file mock data trong src/mock-data/ và src/data/
# real  = gọi API thật từ Spring Boot
VITE_DATA_MODE=mock

# Giá gói (chỉ hiển thị, không quyết định quyền truy cập)
VITE_MONTHLY_PLAN_PRICE=129000
VITE_ANNUAL_PLAN_PRICE=1299000
VITE_ADMISSION_PASS_PRICE=779000
VITE_DEMO_SCENARIO=ANNUAL_DEMO
